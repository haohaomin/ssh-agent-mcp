{
  "name": "ssh-agent-mcp",
  "version": "0.1.0",
  "description": "Unified SSH MCP server with OpenSSH config import, ssh2 sessions, files, jobs and forwarding",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "ssh-agent-mcp": "build/index.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build",
    "start": "node build/index.js",
    "docs:tools": "npm run build && node scripts/generate-tool-reference.js",
    "docs:build": "npm run docs:tools && node scripts/build-site.js",
    "docs:check": "node scripts/check-site.js",
    "docs:serve": "node scripts/serve-site.js"
  },
  "keywords": [
    "ssh",
    "mcp",
    "server",
    "cli"
  ],
  "license": "ISC AND MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "picomatch": "^4.0.7",
    "socks": "^2.8.7",
    "ssh2": "1.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/picomatch": "^4.0.3",
    "@types/ssh2": "^1.15.5",
    "marked": "^18.1.1",
    "typescript": "^5.8.2"
  },
  "files": [
    "build/**/*",
    "LICENSES/**/*",
    "THIRD_PARTY.md",
    "docs/**/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haohaomin/ssh-agent-mcp.git"
  },
  "homepage": "https://haohaomin.github.io/ssh-agent-mcp/",
  "bugs": {
    "url": "https://github.com/haohaomin/ssh-agent-mcp/issues"
  }
}
